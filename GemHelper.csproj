<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Library</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <DebugType>embedded</DebugType>
    <PathMap>$(MSBuildProjectDirectory)=$(MSBuildProjectName)</PathMap>
    <EmbedAllSources>true</EmbedAllSources>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--Don't bother setting anything to do with the output path, HUD will do it for you if you put the source code inside Plugins/Source-->

    <!--
      HUD root (contains ExileCore.dll, GameOffsets.dll, Hexa.NET.ImGui.dll).
      Default: three levels up from the project folder: Plugins/Source/GemHelper -> HUD root.
      Can be overridden: dotnet build -p:ExileApiDir="D:\path\to\hud"
      NOTE: intentionally not using $(exapiPackage) - it points to the old 3.24 install on this machine.
    -->
    <ExileApiDir Condition="'$(ExileApiDir)' == ''">$(MSBuildProjectDirectory)\..\..\..</ExileApiDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="ExileCore">
      <HintPath>$(ExileApiDir)\ExileCore.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="GameOffsets">
      <HintPath>$(ExileApiDir)\GameOffsets.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Hexa.NET.ImGui">
      <HintPath>$(ExileApiDir)\Hexa.NET.ImGui.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- SharpDX is required for Graphics.DrawFrame(RectangleF, Color, int) / DrawTextWithBackground -->
    <Reference Include="SharpDX">
      <HintPath>$(ExileApiDir)\SharpDX.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="SharpDX.Mathematics">
      <HintPath>$(ExileApiDir)\SharpDX.Mathematics.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- ImGui.NET (NuGet) is incompatible with 330.5: the HUD is built against Hexa.NET.ImGui 3.1.0-test1 -->
    <Using Include="Hexa.NET.ImGui" />
  </ItemGroup>
</Project>
