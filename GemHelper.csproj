<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Library</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <DebugType>embedded</DebugType>
    <PathMap>$(MSBuildProjectDirectory)=$(MSBuildProjectName)</PathMap>
    <EmbedAllSources>true</EmbedAllSources>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--Don't bother setting anything to do with the output path, HUD will do it for you if you put the source code inside Plugins/Source-->

    <!--
      Корень HUD (там лежат ExileCore.dll, GameOffsets.dll, Hexa.NET.ImGui.dll).
      По умолчанию — три уровня вверх от папки проекта: Plugins/Source/GemHelper -> корень HUD.
      Можно переопределить: dotnet build -p:ExileApiDir="D:\path\to\hud"
      ВАЖНО: специально не используем $(exapiPackage) — в системе она указывает на старую 3.24.
    -->
    <ExileApiDir Condition="'$(ExileApiDir)' == ''">$(MSBuildProjectDirectory)\..\..\..</ExileApiDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="ExileCore">
      <HintPath>$(ExileApiDir)\ExileCore.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="GameOffsets">
      <HintPath>$(ExileApiDir)\GameOffsets.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Hexa.NET.ImGui">
      <HintPath>$(ExileApiDir)\Hexa.NET.ImGui.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- SharpDX нужен для Graphics.DrawFrame(RectangleF, Color, int) / DrawTextWithBackground -->
    <Reference Include="SharpDX">
      <HintPath>$(ExileApiDir)\SharpDX.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="SharpDX.Mathematics">
      <HintPath>$(ExileApiDir)\SharpDX.Mathematics.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- ImGui.NET (NuGet) несовместим с 330.5: HUD собран под Hexa.NET.ImGui 3.1.0-test1 -->
    <Using Include="Hexa.NET.ImGui" />
  </ItemGroup>
</Project>
